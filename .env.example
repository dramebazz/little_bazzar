# MongoDB Atlas connection string, including the database name.
MONGODB_URI=

# Generate a fresh key with: openssl rand -hex 32
APP_SESSION_SECRET=

# The single store owner's email and scrypt password hash.
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD_HASH=

# Optional public map configuration; only use a browser-safe key.
PUBLIC_API_URL=
PUBLIC_API_KEY=

# Optional server-only auxiliary integrations.
SERVICE_API_URL=
SERVICE_API_KEY=
SERVICE_USER_SESSION_HEADER=
DEV_ALLOWED_HOSTS=
